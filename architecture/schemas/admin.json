{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://tendbee.se/schemas/admin.json",
  "title": "AdminObjects",
  "description": "Schemas for admin operations",
  "definitions": {
    "Connector": {
      "type": "object",
      "description": "Job source connector configuration",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique connector identifier"
        },
        "name": {
          "type": "string",
          "description": "Human-readable name"
        },
        "source": {
          "type": "string",
          "enum": ["platsbanken", "linkedin", "indeed", "partner"],
          "description": "Source system type"
        },
        "type": {
          "type": "string",
          "enum": ["api", "webhook", "rss", "scraper"],
          "description": "Connection type"
        },
        "status": {
          "type": "string",
          "enum": ["active", "paused", "error", "disabled"],
          "default": "active"
        },
        "config": {
          "type": "object",
          "properties": {
            "api_key": {
              "type": "string",
              "description": "API key (encrypted)"
            },
            "api_url": {
              "type": "string",
              "format": "uri"
            },
            "webhook_secret": {
              "type": "string"
            },
            "rate_limit": {
              "type": "integer",
              "description": "Max requests per minute"
            },
            "fetch_interval_minutes": {
              "type": "integer",
              "default": 15
            },
            "filters": {
              "type": "object",
              "properties": {
                "regions": {
                  "type": "array",
                  "items": { "type": "string" }
                },
                "categories": {
                  "type": "array",
                  "items": { "type": "string" }
                },
                "keywords": {
                  "type": "array",
                  "items": { "type": "string" }
                }
              }
            }
          }
        },
        "stats": {
          "type": "object",
          "properties": {
            "last_fetch": {
              "type": "string",
              "format": "date-time"
            },
            "last_success": {
              "type": "string",
              "format": "date-time"
            },
            "last_error": {
              "type": "string",
              "format": "date-time"
            },
            "last_error_message": {
              "type": "string"
            },
            "jobs_fetched_total": {
              "type": "integer"
            },
            "jobs_fetched_24h": {
              "type": "integer"
            },
            "error_count_24h": {
              "type": "integer"
            },
            "success_rate_24h": {
              "type": "number"
            }
          }
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "IngestLog": {
      "type": "object",
      "description": "Log entry for job ingestion",
      "properties": {
        "ingest_id": {
          "type": "string"
        },
        "connector_id": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "external_job_id": {
          "type": "string"
        },
        "canonical_job_id": {
          "type": "string",
          "description": "Internal job ID after processing"
        },
        "status": {
          "type": "string",
          "enum": ["queued", "processing", "completed", "failed", "duplicate", "skipped"]
        },
        "action": {
          "type": "string",
          "enum": ["create", "update", "delete"]
        },
        "error": {
          "type": "string",
          "description": "Error message if failed"
        },
        "error_type": {
          "type": "string",
          "enum": ["parse_error", "validation_error", "duplicate", "rate_limit", "network_error", "unknown"]
        },
        "processing_time_ms": {
          "type": "integer"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "completed_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "ReviewQueueItem": {
      "type": "object",
      "description": "Item requiring manual review",
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "enum": ["parse_error", "duplicate_review", "quality_check", "reported_content"]
        },
        "source": {
          "type": "string"
        },
        "job_id": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "raw_payload": {
          "type": "object"
        },
        "suggested_action": {
          "type": "string",
          "enum": ["approve", "reject", "merge", "edit"]
        },
        "status": {
          "type": "string",
          "enum": ["pending", "in_progress", "resolved", "escalated"]
        },
        "assigned_to": {
          "type": "string"
        },
        "resolution": {
          "type": "string"
        },
        "resolved_by": {
          "type": "string"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "resolved_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "GDPRRequest": {
      "type": "object",
      "description": "GDPR data subject request",
      "properties": {
        "request_id": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "enum": ["export", "delete", "rectify"]
        },
        "user_id": {
          "type": "string"
        },
        "user_email": {
          "type": "string",
          "format": "email"
        },
        "status": {
          "type": "string",
          "enum": ["pending", "processing", "completed", "failed"]
        },
        "requested_at": {
          "type": "string",
          "format": "date-time"
        },
        "completed_at": {
          "type": "string",
          "format": "date-time"
        },
        "deadline": {
          "type": "string",
          "format": "date-time",
          "description": "30 days from request"
        },
        "export_url": {
          "type": "string",
          "format": "uri",
          "description": "Download URL for export (time-limited)"
        },
        "processed_by": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "AdminUser": {
      "type": "object",
      "description": "Admin user account",
      "properties": {
        "id": {
          "type": "string"
        },
        "email": {
          "type": "string",
          "format": "email"
        },
        "name": {
          "type": "string"
        },
        "role": {
          "type": "string",
          "enum": ["super_admin", "admin", "support", "analyst"]
        },
        "permissions": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "connectors:read",
              "connectors:write",
              "users:read",
              "users:write",
              "users:delete",
              "gdpr:export",
              "gdpr:delete",
              "jobs:read",
              "jobs:write",
              "jobs:delete",
              "matches:read",
              "matches:override",
              "analytics:read",
              "settings:read",
              "settings:write"
            ]
          }
        },
        "two_factor_enabled": {
          "type": "boolean",
          "default": false
        },
        "last_login": {
          "type": "string",
          "format": "date-time"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
